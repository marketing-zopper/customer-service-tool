# --- Supabase (service-role key is server-side only, never exposed to the browser) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Sign-in mode ---
# legacy (default): shared marketing password + magic links, exactly as before.
# google: Google sign-in + the central Upstash employee check; password and magic links are refused.
# Switch back to legacy at any time to roll back.
AUTH_MODE=legacy

# --- Central employee access (Zopper Marketing Studio's Upstash Redis). Needed when AUTH_MODE=google. ---
# This app only ever sends HGET on zms:employees. Use a READ-ONLY Upstash token if you can.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# How long a looked-up role is remembered, so one page of requests is one lookup (default 10)
# ACCESS_CACHE_SECONDS=10
# How long a Google sign-in lasts before Google is asked again, which is silent (default 7)
# SESSION_DAYS=7
# The Google client id/secret are NOT set here: they live in Supabase Auth (see README, "Google sign-in").

# --- Access control ---
# Shared password for the five marketing-team members
ADMIN_PASSWORD=
# 32+ random characters, signs the admin session cookie:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Public URL of the deployed app; used to build magic links and the logo in emails
APP_URL=http://localhost:5173
MAGIC_LINK_TTL_DAYS=7

# --- Escalation email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=Zopper Service Triage <triage@your-verified-domain.com>


# --- Webflow form submissions (read-only; the app only sends GET requests) ---
# Site API token with read access to forms. Site ID: Site settings → General, or the Webflow API.
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
# Forms to triage, separated by | (defaults to the two lead-generation forms)
# WEBFLOW_FORMS=Lead Generation (Component)|Lead Generation (Contact Page)
WEBFLOW_LOOKBACK_DAYS=90
WEBFLOW_MAX_PER_RUN=300
