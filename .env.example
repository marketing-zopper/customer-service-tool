# --- Supabase (service-role key is server-side only, never exposed to the browser) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Access control ---
# Shared password for the five marketing-team members
ADMIN_PASSWORD=
# 32+ random characters, signs the admin session cookie:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Public URL of the deployed app; used to build magic links and the logo in emails
APP_URL=http://localhost:5173
MAGIC_LINK_TTL_DAYS=7

# --- Escalation email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=Zopper Service Triage <triage@your-verified-domain.com>

# --- Gmail ingestion ---
GMAIL_MAILBOX=marketingext@zopper.com
# Service-account key JSON (raw, or base64-encoded). Needs domain-wide delegation for the gmail.readonly scope.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Bearer secret for the scheduled /api/ingest call (Vercel sends it automatically when set)
CRON_SECRET=
INGEST_LOOKBACK_DAYS=3
INGEST_MAX_PER_RUN=20

# --- Webflow form submissions (read-only; the app only sends GET requests) ---
# Site API token with read access to forms. Site ID: Site settings → General, or the Webflow API.
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
# Forms to triage, separated by | (defaults to the two lead-generation forms)
# WEBFLOW_FORMS=Lead Generation (Component)|Lead Generation (Contact Page)
WEBFLOW_LOOKBACK_DAYS=90
WEBFLOW_MAX_PER_RUN=300
